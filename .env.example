# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values there.
# The `.env` file is git-ignored, so your secret keys are never committed.
# -----------------------------------------------------------------------------

# Port the backend server listens on (defaults to 3000 if not set).
PORT=3000

# -----------------------------------------------------------------------------
# AI provider configuration (NOT needed yet — the app currently uses a mock
# reply). When you pick a provider in Stage 3, uncomment the matching block
# and paste your key here. Do NOT put any key directly in the source code.
# -----------------------------------------------------------------------------

# Example (choose ONE provider later, delete the rest):
# AI_PROVIDER=groq
# AI_API_KEY=your_api_key_here
# AI_MODEL=your_model_name_here
